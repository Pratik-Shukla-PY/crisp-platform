{
  "name": "crisp-mobile",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "jest"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/__tests__/**/*.test.(ts|tsx|js|jsx)"
    ],
    "transform": {
      "^.+\\.(ts|tsx|js|jsx)$": [
        "babel-jest",
        {
          "presets": [
            [
              "@babel/preset-env",
              {
                "targets": {
                  "node": "current"
                }
              }
            ],
            "@babel/preset-typescript"
          ]
        }
      ]
    },
    "moduleNameMapper": {
      "^@react-native-async-storage/async-storage$": "<rootDir>/__tests__/__mocks__/async-storage.ts",
      "^@react-native-community/netinfo$": "<rootDir>/__tests__/__mocks__/netinfo.ts",
      "^expo-localization$": "<rootDir>/__tests__/__mocks__/expo-localization.ts",
      "^expo-sqlite$": "<rootDir>/__tests__/__mocks__/expo-sqlite.ts",
      "^expo-crypto$": "<rootDir>/__tests__/__mocks__/expo-crypto.ts",
      "^expo-constants$": "<rootDir>/__tests__/__mocks__/expo-constants.ts",
      "^react-native$": "<rootDir>/__tests__/__mocks__/react-native.ts"
    },
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/__tests__/__mocks__/"
    ]
  },
  "dependencies": {
    "@expo/ngrok": "^4.1.3",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "11.4.1",
    "@tensorflow-models/blazeface": "^0.1.0",
    "@tensorflow/tfjs": "^4.22.0",
    "expo": "~54.0.33",
    "expo-audio": "~1.1.1",
    "expo-background-fetch": "~14.0.9",
    "expo-camera": "~17.0.10",
    "expo-crypto": "~15.0.8",
    "expo-file-system": "~19.0.21",
    "expo-font": "~14.0.11",
    "expo-image-manipulator": "~14.0.8",
    "expo-image-picker": "~17.0.10",
    "expo-localization": "~17.0.8",
    "expo-location": "~19.0.8",
    "expo-notifications": "~0.32.16",
    "expo-sqlite": "~16.0.10",
    "expo-status-bar": "~3.0.9",
    "expo-task-manager": "~14.0.9",
    "jpeg-js": "^0.4.4",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-reanimated": "~4.1.4",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-svg": "^15.15.4",
    "react-native-view-shot": "~4.0.3",
    "react-native-webview": "13.15.0"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.29.2",
    "@babel/preset-typescript": "^7.28.5",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.1.0",
    "jest": "^30.3.0",
    "jest-expo": "^54.0.17",
    "typescript": "~5.9.2"
  },
  "private": true
}
