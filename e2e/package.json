{
  "name": "crisp-e2e",
  "version": "1.0.0",
  "private": true,
  "description": "End-to-end test suite for CRISP — covers every critical button on PWA + Dashboard via Playwright.",
  "scripts": {
    "test": "playwright test",
    "test:pwa": "playwright test --project=pwa",
    "test:dashboard": "playwright test --project=dashboard",
    "test:smoke": "playwright test --grep=@smoke",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:axe": "playwright test 40-axe-a11y --project=pwa",
    "test:offline": "playwright test 41-offline-strict --project=pwa",
    "test:visual": "playwright test 42-visual-regression --project=pwa",
    "test:visual:update": "playwright test 42-visual-regression --project=pwa --update-snapshots",
    "report": "playwright show-report",
    "check:prod": "playwright test --config=playwright.prod.config.ts",
    "check:prod:ui": "playwright test --config=playwright.prod.config.ts --ui"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@playwright/test": "^1.47.0"
  }
}
