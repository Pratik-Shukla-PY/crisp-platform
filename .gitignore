# Environment & secrets
.env
.env.*
# Allow template files (e.g. .env.production.example) — these are
# checked in to document required prod env vars with blank values.
!.env.*.example

# Python
__pycache__/
*.pyc
*.pyo
venv/
*.egg-info/

# Node
node_modules/

# Playwright test artefacts (regenerated on every run)
playwright-report/
test-results/

# Logs & runtime
*.log
*.pid
logs/

# macOS
.DS_Store

# Database
*.sqlite
*.sqlite3
*.db
*.db.bak
*.db.pre-*.bak

# Uploads (runtime user data)
backend/uploads/

# ML model weights
*.pth
*.pt
*.bin

# IDE
.vscode/
.idea/

# Terraform
.terraform/
*.tfstate
*.tfstate.backup

# Docker
*.tar

# CRISP runtime
.crisp.pids
nohup.out
!.env.example
