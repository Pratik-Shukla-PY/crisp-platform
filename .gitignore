# Environment & secrets
.env
.env.*
# Allow template files (e.g. .env.production.example) — these are
# checked in to document required prod env vars with blank values.
!.env.*.example

# Python
__pycache__/
*.pyc
*.pyo
venv/
*.egg-info/

# Node
node_modules/

# Playwright test artefacts (regenerated on every run)
playwright-report/
playwright-report-prod/
test-results/
# Screenshot captures from i18n + visual specs (e2e/tests/pwa/25-i18n-
# 22-screenshots.spec.ts and friends). Regenerated on every run; never
# part of the UNDP-submission build.
e2e/screenshots/

# Lighthouse CI output — regenerated on every run, archived to the
# `lighthouse-history` orphan branch by scripts/lighthouse-publish.mjs.
.lighthouseci/
# If we ever `git checkout origin/lighthouse-history -- <sha>` to
# inspect a report locally, it stages those files on main. Ignore the
# pattern so it can't accidentally end up in a main commit.
/[0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f]*-prod/
/[0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f-]*/summary.json

# Visual-regression snapshots: only commit the Linux baselines (which
# CI generates). macOS / Windows local-dev snapshots are platform-
# specific and shouldn't be committed.
e2e/tests/pwa/42-visual-regression.spec.ts-snapshots/*-darwin.png
e2e/tests/pwa/42-visual-regression.spec.ts-snapshots/*-win32.png

# Logs & runtime
*.log
*.pid
logs/

# macOS
.DS_Store

# Database
*.sqlite
*.sqlite3
*.db
*.db.bak
*.db.pre-*.bak

# Uploads (runtime user data)
backend/uploads/
backend/uploads_test/

# ML model weights
*.pth
*.pt
*.bin
# Vendored TF.js model weights (BlazeFace) — small enough to track,
# eliminates the Kaggle CORS 404 PII-blur production bug.
!mobile-app/src/vendor/blazeface/*.bin

# Local developer notes (untracked working files; not part of the product)
CLAUDE.md
# Internal design references + scratch planning — kept on disk for
# the operator, NEVER deployed. Anything we generate as scratch
# planning, walkthroughs, or runbooks belongs here, not on origin.
# Add new entries to this block.
docs/NEARBY_REPORTS_PIPELINE.md
docs/nearby-pipeline-workflow.html
PHASE-K-APPROVAL.html

# Validation: per-scenario run artifacts (regenerated on every run; only
# the soak-50 evidence + 00_baseline_hashes.json are committed). Future
# scenarios shouldn't add to the repo unless explicitly preserved.
validation/results/*/
!validation/results/13-soak-50/
# Validation report + dev helper scripts (kept locally; not part of the
# prod build or the deploy artifact).
validation/VALIDATION-REPORT.md
validation/scripts/

# Dev probes + seed scripts (underscore-prefixed; not picked up by the
# playwright spec runner or any deploy step).
e2e/_*.mjs
backend/scripts/seed_nearby_dummy.py

# IDE
.vscode/
.idea/

# Terraform
.terraform/
*.tfstate
*.tfstate.backup

# Docker
*.tar

# CRISP runtime
.crisp.pids
nohup.out
!.env.example
