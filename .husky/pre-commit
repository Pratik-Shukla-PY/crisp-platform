#!/usr/bin/env sh
# CRISP pre-commit hook (May 2026, Sprint 3).
#
# Catches the four classes of bug that hit us in the May deploy night
# BEFORE they leave the developer's laptop. Each check exits non-zero
# on failure — no soft warnings, no bypass without explicit
# `--no-verify` (which we discourage; see CLAUDE.md).
#
# Order matters: lockfile drift first (cheapest, blocks `npm ci`),
# then shellcheck (sub-second), then node --check (sub-second), then
# actionlint (requires a local install — falls through to a warn
# if missing; CI catches it as a hard gate anyway).

set -e

# ── 1. Lockfile drift (mobile-app / crisp-mobile / e2e) ──────────────
# If package.json changed but package-lock.json didn't, `npm ci` will
# crash later with "missing from lock file". This is the exact bug
# that caused the RN typecheck job to fail in the May deploy.
for pkg in mobile-app crisp-mobile e2e; do
    if git diff --cached --name-only | grep -q "^${pkg}/package\.json$" && \
       ! git diff --cached --name-only | grep -q "^${pkg}/package-lock\.json$"; then
        echo "✗ ${pkg}/package.json was staged but ${pkg}/package-lock.json wasn't."
        echo "  Run: cd ${pkg} && npm install"
        echo "  Then: git add ${pkg}/package-lock.json && git commit --amend --no-edit"
        exit 1
    fi
done

# ── 2. shellcheck on touched .sh ─────────────────────────────────────
sh_staged=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.sh$' || true)
if [ -n "$sh_staged" ]; then
    if command -v shellcheck >/dev/null 2>&1; then
        # -x for `source` recursion. Errors on SC2012-class bugs.
        # shellcheck disable=SC2086
        echo "$sh_staged" | xargs -n1 shellcheck -x
    else
        echo "  (shellcheck not installed locally; CI will catch shell issues)"
    fi
fi

# ── 3. node --check on touched .js / .cjs / .mjs ─────────────────────
js_staged=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(js|cjs|mjs)$' | grep -v 'node_modules/' || true)
if [ -n "$js_staged" ]; then
    if command -v node >/dev/null 2>&1; then
        # shellcheck disable=SC2086
        echo "$js_staged" | xargs -n1 node --check
    else
        echo "  (node not installed locally; CI will catch JS syntax errors)"
    fi
fi

# ── 4. actionlint on touched workflow YAML ──────────────────────────
wf_staged=$(git diff --cached --name-only --diff-filter=ACM | grep -E '^\.github/workflows/.*\.ya?ml$' || true)
if [ -n "$wf_staged" ]; then
    if command -v actionlint >/dev/null 2>&1; then
        actionlint -color -shellcheck=
    else
        echo "  (actionlint not installed locally; CI hard-gate will catch workflow issues)"
        echo "  Install: brew install actionlint  (or see https://github.com/rhysd/actionlint)"
    fi
fi

# ── 5. inline 22-locale i18n packs drift ─────────────────────────────
# Catches: developer edited any locale JSON (or index.html's inline block)
# but forgot to re-run scripts/generate-home-i18n-inline.mjs. Pack
# contents would drift behind source JSON, reintroducing the
# language-flash bug for the affected locale.
#
# Two layers:
#   (a) generate-home-i18n-inline.mjs --check  — hard gate on drift
#       between the inline 22-locale block in index.html and the source
#       JSONs. Single source of truth (it knows the build rule).
#   (b) validate-home-i18n-packs.mjs            — pack-content integrity
#       (checksums match payload, all 22 locales present, no broken JSON).
i18n_staged=$(git diff --cached --name-only --diff-filter=ACM | \
              grep -E '^(mobile-app/src/i18n/[a-z]{2,3}\.json|mobile-app/src/index\.html)$' || true)
if [ -n "$i18n_staged" ]; then
    if command -v node >/dev/null 2>&1; then
        if ! node scripts/generate-home-i18n-inline.mjs --check; then
            echo ""
            echo "✗ Inline 22-locale i18n pack drift detected."
            echo "  Run: node scripts/generate-home-i18n-inline.mjs"
            echo "  Then: git add mobile-app/src/index.html"
            exit 1
        fi
        if ! node scripts/validate-home-i18n-packs.mjs; then
            echo ""
            echo "✗ Inline pack content validation failed."
            exit 1
        fi
    fi
fi

# ── 5b. crisis-pack curated-option i18n coverage ────────────────────
# Every stock crisis-pack question + select option must have a
# cp_/cpopt_ key in en.json — the PWA pack renderer localizes the
# (English-only) stock packs via those keys. Fires when a locale file
# OR the stock-pack source (cc-crisis.js) changes, so adding a question
# without a translation key fails the commit. validate-i18n.mjs then
# enforces 22-locale parity of the keys.
cp_i18n_staged=$(git diff --cached --name-only --diff-filter=ACM | \
                 grep -E '^(mobile-app/src/i18n/[a-z]{2,3}\.json|web-dashboard/src/cc-crisis\.js)$' || true)
if [ -n "$cp_i18n_staged" ]; then
    if command -v node >/dev/null 2>&1; then
        if ! node scripts/validate-crisis-pack-i18n.mjs; then
            echo ""
            echo "✗ Crisis-pack i18n coverage failed — a stock question/option lacks a cp_/cpopt_ key."
            echo "  Add the key(s) to all 22 mobile-app/src/i18n/*.json files."
            exit 1
        fi
    fi
fi

# ── 6. SW asset manifest drift ──────────────────────────────────────
# Sprint 1A (May 2026, post-HC88) — catches the silent-drift bug class
# that hit us in HC84/85: a developer edits any precached file (locale
# JSON, app.js, styles.css, etc.) but forgets to re-run
# scripts/generate-sw-manifest.mjs. The manifest hashes in sw.js then
# drift behind actual content, defeating the per-asset migration in
# the install handler — returning users re-download the full ~1.2 MB
# shell instead of taking the per-file delta. No correctness break,
# but the bandwidth optimization is silently bypassed.
#
# Trigger: any file under mobile-app/src/ being staged. The check
# itself is ~50ms so a slight over-fire is cheaper than missing drift.
sw_asset_staged=$(git diff --cached --name-only --diff-filter=ACM | \
                  grep -E '^mobile-app/src/' || true)
if [ -n "$sw_asset_staged" ]; then
    if command -v node >/dev/null 2>&1; then
        if ! node scripts/generate-sw-manifest.mjs --check; then
            echo ""
            echo "✗ SW asset manifest drift detected."
            echo "  Run: node scripts/generate-sw-manifest.mjs"
            echo "  Then: git add mobile-app/src/sw.js"
            exit 1
        fi
    fi
fi

echo "✓ pre-commit checks passed"
