# ══════════════════════════════════════════════════════════════
#  CRISP Platform — PRODUCTION environment template
#
#  Copy this file to `.env.production`, fill every value marked
#  REQUIRED, and set `APP_ENV=production` before launching.
#
#  Read docs/DEPLOYMENT_RUNBOOK.md first — this file is only
#  the variable checklist, not the full setup walkthrough.
# ══════════════════════════════════════════════════════════════

# ── Runtime mode (REQUIRED) ──────────────────────────────────
APP_ENV=production
# Lower than dev — production must not log PII by default. Flip to DEBUG only
# during a targeted incident investigation and flip back immediately.
LOG_LEVEL=INFO

# ── Database (REQUIRED for scale) ────────────────────────────
# SQLite is acceptable for CI + local dev only. At UNDP RAPIDA target
# volumes (50k / 250k / 500k reports per crisis) SQLite's global write
# lock is a hard bottleneck — production MUST point at PostgreSQL ≥ 14.
DATABASE_URL=postgresql+psycopg2://crisp:CHANGE_ME@db.internal:5432/crisp
# Run `alembic upgrade head` against this URL before booting the app.

# ── Security (REQUIRED) ──────────────────────────────────────
# Generate with: ./scripts/rotate_secrets.sh (must be ≥ 64 hex chars).
JWT_SECRET=
# Admin API key protecting purge/audit/user-list endpoints.
CRISP_ADMIN_KEY=
# CORS origins — set ONLY the public dashboard domain here, no LAN IPs.
CORS_ORIGINS=https://crisp.example.org

# ── Anthropic (REQUIRED for AI assessment) ───────────────────
# Model: claude-haiku (cheap, fast). Cost budget documented in
# docs/INFRA-COSTS.md.
ANTHROPIC_API_KEY=

# ── Satellite imagery (UNDP truth-verification) ──────────────
# Apr 2026 — Sentinel Hub retired in favour of an open-source provider
# chain (AWS Open Data Sentinel-2 → Microsoft Planetary Computer →
# ESA Copernicus Data Space → Mapbox). The chain works with ZERO
# credentials — AWS Sentinel-2 needs no auth — but adding the
# optional ones below improves coverage and resilience.
#
# Mapbox: rendered satellite tile fallback. Free tier 50k req/month.
# Without this, the chain still serves Sentinel-2 imagery from AWS /
# MPC / CDSE, just without the high-res Maxar comparison view.
MAPBOX_TOKEN=
# Microsoft Planetary Computer: optional API key for higher rate limits
# on STAC search and rendered_preview asset access. Sign up free at
# https://planetarycomputer.microsoft.com/ — leave blank to use anon
# rate limits, which are sufficient for low-volume verification.
MPC_API_KEY=
# ESA Copernicus Data Space (CDSE): optional OAuth credentials for
# downloading full Sentinel-2 COG bands. The QUICKLOOK preview asset
# (which is what we consume for verification thumbnails) doesn't
# require auth — leave these blank unless we add full-band processing.
CDSE_USERNAME=
CDSE_PASSWORD=

# ── Messaging channels (set the ones you use) ────────────────
# Telegram — set webhook URL separately once the service is live.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_PATH_SECRET=

# WhatsApp Cloud API
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_PATH_SECRET=

# Twilio SMS + IVR
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
SMS_WEBHOOK_PATH_SECRET=
IVR_WEBHOOK_PATH_SECRET=

# ── Observability (recommended) ──────────────────────────────
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.05
CRISP_RELEASE=                # git sha or release tag

# ── Background worker tuning ─────────────────────────────────
# Media assembly pool size. Default is 4 (matches a small cloud VM).
# Increase to the instance's vCPU count; there's little benefit going
# higher because PII blur + Whisper release the GIL only during ffmpeg.
CRISP_ASSEMBLY_WORKERS=4
# AI pool runs PII redaction + Whisper + Haiku. 2 is a conservative
# default; raise to 4 on instances with ≥ 8 vCPU.
CRISP_AI_WORKERS=2

# ── Web Push (VAPID, RFC 8292) ───────────────────────────────
# Generate ONCE per environment via:
#     cd backend && source venv/bin/activate
#     python scripts/generate_vapid.py
# Persist BOTH halves to AWS Secrets Manager + this file. The PUBLIC
# key is exposed to clients via /api/v1/push/vapid-public and embedded
# in every browser-issued subscription endpoint — rotating it
# invalidates every existing subscription. Only rotate if forced
# (e.g. private key leak). When all three are empty, the push service
# short-circuits at startup; the platform still boots and serves the
# rest of the API normally — push is "feature off" rather than failing.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Provider abuse-contact (RFC 8292 §2). Use an on-call mailbox.
VAPID_CONTACT_EMAIL=admin@undp.crisplabs.tech
