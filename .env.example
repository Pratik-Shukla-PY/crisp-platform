# ══════════════════════════════════════════════════════════════
#  CRISP Platform — Environment Variables
#  Copy this file to .env and fill in your credentials.
# ══════════════════════════════════════════════════════════════

# ── Anthropic (AI truth verification — Claude Haiku) ────────
# Get from: https://console.anthropic.com/
ANTHROPIC_API_KEY=

# ── Google Gemini (optional, alternative AI backend) ────────
# Get from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# ── Sentinel Hub (Copernicus / ESA — primary satellite source) ─
# Get from: https://apps.sentinel-hub.com/dashboard/#/account/settings
# Create an OAuth Client under "User settings > OAuth clients"
SENTINEL_HUB_CLIENT_ID=
SENTINEL_HUB_CLIENT_SECRET=

# ── Mapbox (fallback satellite when Sentinel cloud cover > 80%) ─
# Get from: https://account.mapbox.com/access-tokens/
# Free tier: 50,000 requests/month
MAPBOX_TOKEN=

# ── Database ───────────────────────────────────────────────────
# SQLite for local dev, PostgreSQL for production
DATABASE_URL=sqlite:///./crisp_local.db
# DATABASE_URL=postgresql://crisp:crisp@localhost:5432/crisp
