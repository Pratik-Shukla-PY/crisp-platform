# ══════════════════════════════════════════════════════════════
#  CRISP Platform — Environment Variables
#  Copy this file to .env and fill in your credentials.
# ══════════════════════════════════════════════════════════════

# ── Anthropic (AI truth verification — Claude Haiku) ────────
# Get from: https://console.anthropic.com/
ANTHROPIC_API_KEY=

# ── Google Gemini (optional, alternative AI backend) ────────
# Get from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# ── Sentinel Hub (Copernicus / ESA — primary satellite source) ─
# Get from: https://apps.sentinel-hub.com/dashboard/#/account/settings
# Create an OAuth Client under "User settings > OAuth clients"
SENTINEL_HUB_CLIENT_ID=
SENTINEL_HUB_CLIENT_SECRET=

# ── Mapbox (fallback satellite when Sentinel cloud cover > 80%) ─
# Get from: https://account.mapbox.com/access-tokens/
# Free tier: 50,000 requests/month
MAPBOX_TOKEN=

# ── WhatsApp Cloud API (Bot integration) ─────────────────────
# Get from: https://developers.facebook.com/apps/ → WhatsApp → API Setup
WHATSAPP_VERIFY_TOKEN=crisp-webhook-verify-2026
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
# Non-guessable webhook path segment (auto-generated if empty)
WHATSAPP_WEBHOOK_PATH_SECRET=

# ── Telegram Bot ─────────────────────────────────────────────
# Get from: @BotFather on Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_PATH_SECRET=

# ── SMS Gateway (Twilio) ─────────────────────────────────────
SMS_WEBHOOK_PATH_SECRET=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ── IVR Voice Calls (Twilio) ─────────────────────────────────
IVR_WEBHOOK_PATH_SECRET=

# ── Database ───────────────────────────────────────────────────
# Apr 2026 — CRISP is PostgreSQL-only. The backend refuses to boot on
# sqlite:/// or an unset DATABASE_URL. Run `scripts/dev-setup.sh` to
# auto-provision a local Postgres (Docker Compose OR Homebrew) and you
# get exactly this DSN.
DATABASE_URL=postgresql+psycopg2://crisp:crisp@localhost:5432/crisp
POSTGRES_PASSWORD=crisp

# ── Security ──────────────────────────────────────────────────
# Runtime mode — set to 'dev' for local work; 'production' is the default and
# forces the boot-time checks below to be strict.
APP_ENV=dev
# JWT signing key — REQUIRED when APP_ENV=production (≥ 64 hex chars).
# Generate with ./scripts/rotate_secrets.sh (see scripts/SECRETS.md).
JWT_SECRET=
# Admin API key for purge/audit/user-list endpoints — REQUIRED in production.
# Generate alongside JWT_SECRET via scripts/rotate_secrets.sh.
CRISP_ADMIN_KEY=
# CORS allowed origins (comma-separated). In production, remove LAN IPs and
# allow only the public dashboard domain.
CORS_ORIGINS=http://localhost:8080,http://localhost:8000
# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# ── Observability (P3.7 / P3.8) ──────────────────────────────
# Sentry DSN — leave blank to disable Sentry. When set, unhandled exceptions
# ship to Sentry with request_id + environment tags (PII scrubbed).
SENTRY_DSN=
# Sentry trace sampling — 0.05 = 5% of requests traced. Lower in production
# to control cost; higher during load tests.
SENTRY_TRACES_SAMPLE_RATE=0.05
# Optional release identifier (git sha or tag). Populates Sentry's release
# field so regressions can be associated with a specific deploy.
CRISP_RELEASE=dev
